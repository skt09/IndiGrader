# ---------------------------------------------------------------
# IndiGrader — .gitignore
# ---------------------------------------------------------------

# --- Generated lab packages -------------------------------------
# builder.py writes Labs/packageIG_<LAB>/ and Labs/packageIG_<LAB>.zip.
# These are build outputs containing real student data — never commit.
Labs/
packageIG_*/
packageIG_*.zip

# --- Builder state ----------------------------------------------
# Remembers per-course defaults (IPs, paths, subnets) between runs.
.builder_profiles.json

# --- Server runtime data ----------------------------------------
# Created by start.sh / task.py at grading time.
logs/
submissions/
late_submissions/
*.log

# --- Rosters & problem statements -------------------------------
# Real class rosters must not be committed. The template placeholders
# under templates/ are already tracked, so they stay visible to git.
/students.txt
/pwd_students.txt

# --- Python -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---------------------------------------
.venv/
venv/
ENV/
env/

# --- Testing & type-checker caches ------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets & local config -------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# --- Editors ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# --- OS cruft ---------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
/ig_clients/

discover_configs.py
ig_clients.zip
test_*.py
